PORT=8790

# Token, který zadáš do Hangaru místo skutečného Anthropic/OpenAI klíče.
HANGAR_AI_PROXY_TOKEN=change-me

# Skutečné provider klíče zůstanou jen na serveru.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Volitelné defaulty
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_BASE_URL=https://api.openai.com
